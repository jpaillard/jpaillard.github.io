<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
    <div class="card" style="border: 1px solid var(--global-divider-color); border-radius: 0.5rem; transition: transform 0.2s, box-shadow 0.2s;">
      <div class="card-body" style="display: flex; align-items: center; gap: 1rem;">
        <img
          id="avatar-{{ include.username }}"
          src="https://github.com/{{ include.username }}.png?size=80"
          alt="{{ include.username }}"
          style="width: 56px; height: 56px; border-radius: 50%;"
          loading="lazy"
        >
        <div style="text-align: left;">
          <h5 class="card-title" style="margin-bottom: 0.2rem; font-size: 1.05rem;">
            <i class="fa-brands fa-github" style="margin-right: 0.3rem;"></i>@{{ include.username }}
          </h5>
          <p id="bio-{{ include.username }}" class="card-text" style="font-size: 0.85rem; color: var(--global-text-color-light); margin-bottom: 0;">
          </p>
        </div>
      </div>
    </div>
  </a>
</div>

<script>
  (function() {
    fetch("https://api.github.com/users/{{ include.username }}")
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.message) return;
        var bio = document.getElementById("bio-{{ include.username }}");
        if (bio && data.bio) {
          bio.textContent = data.bio;
        }
      })
      .catch(function() {});
  })();
</script>
