<div class="github-user-card">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <div class="github-user-card-inner">
      <img
        id="avatar-{{ include.username }}"
        class="github-user-avatar"
        src="https://github.com/{{ include.username }}.png?size=120"
        alt="{{ include.username }}"
        loading="lazy"
      >
      <div class="github-user-info">
        <h5 class="github-user-name">
          <i class="fa-brands fa-github"></i>
          <span id="name-{{ include.username }}">@{{ include.username }}</span>
        </h5>
        <p id="bio-{{ include.username }}" class="github-user-bio"></p>
        <div id="user-stats-{{ include.username }}" class="github-user-stats"></div>
      </div>
    </div>
  </a>
</div>

<script>
  (function () {
    fetch('https://api.github.com/users/{{ include.username }}')
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (data.message) return;
        var nameEl = document.getElementById('name-{{ include.username }}');
        if (nameEl && data.name) {
          nameEl.textContent = data.name;
        }
        var bio = document.getElementById('bio-{{ include.username }}');
        if (bio && data.bio) {
          bio.textContent = data.bio;
        }
        var stats = document.getElementById('user-stats-{{ include.username }}');
        if (stats) {
          var parts = [];
          if (data.public_repos) {
            parts.push('<span><i class="fa-solid fa-book-bookmark"></i>' + data.public_repos + ' repos</span>');
          }
          if (data.followers) {
            parts.push('<span><i class="fa-solid fa-users"></i>' + data.followers + ' followers</span>');
          }
          stats.innerHTML = parts.join('');
        }
      })
      .catch(function () {});
  })();
</script>
