<div class="github-trophies">
  <img
    class="only-light"
    alt="{{ include.username }} GitHub trophies"
    src="{{ site.external_services.github_profile_trophy_url }}/?username={{ include.username }}&theme={{ site.repo_trophies.theme_light }}&locale={{ site.lang }}&margin-w=15&margin-h=15&no-bg=true&rank=-C&column=-1"
    loading="lazy"
  >
  <img
    class="only-dark"
    alt="{{ include.username }} GitHub trophies"
    src="{{ site.external_services.github_profile_trophy_url }}/?username={{ include.username }}&theme={{ site.repo_trophies.theme_dark }}&locale={{ site.lang }}&margin-w=15&margin-h=15&no-bg=true&rank=-C&column=-1"
    loading="lazy"
  >
</div>
