{% assign repo_parts = include.repository | split: '/' %}
{% assign owner = repo_parts[0] %}
{% assign name = repo_parts[1] %}

<div class="repo-card">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card-inner">
      <div class="repo-card-header">
        <i class="fa-brands fa-github repo-icon"></i>
        <span class="repo-name">
          {% if owner != site.data.repositories.github_users.first %}
            <span class="repo-owner">{{ owner }}/</span>
          {% endif %}
          {{ name }}
        </span>
      </div>
      <p class="repo-description" id="desc-{{ owner }}-{{ name }}">
        {% if include.description %}
          {{ include.description }}
        {% endif %}
      </p>
      <div class="repo-meta" id="stats-{{ owner }}-{{ name }}"></div>
    </div>
  </a>
</div>

<script>
  (function () {
    var langColors = {
      Python: "#3572A5",
      JavaScript: "#f1e05a",
      TypeScript: "#3178c6",
      R: "#198CE7",
      Julia: "#a270ba",
      Java: "#b07219",
      "C++": "#f34b7d",
      C: "#555555",
      Rust: "#dea584",
      Go: "#00ADD8",
      MATLAB: "#e16737",
      Shell: "#89e051",
      Jupyter: "#DA5B0B",
      "Jupyter Notebook": "#DA5B0B",
      HTML: "#e34c26",
      CSS: "#563d7c",
    };
    fetch("https://api.github.com/repos/{{ include.repository }}")
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (data.message) return;
        var stats = document.getElementById("stats-{{ owner }}-{{ name }}");
        if (stats) {
          var parts = [];
          if (data.language) {
            var color = langColors[data.language] || "#858585";
            parts.push(
              '<span class="repo-lang"><span class="lang-dot" style="background:' +
                color +
                ';"></span>' +
                data.language +
                "</span>",
            );
          }
          parts.push(
            '<span class="repo-stat"><i class="fa-regular fa-star"></i>' +
              data.stargazers_count +
              "</span>",
          );
          parts.push(
            '<span class="repo-stat"><i class="fa-solid fa-code-fork"></i>' +
              data.forks_count +
              "</span>",
          );
          stats.innerHTML = parts.join("");
        }
        {% unless include.description %}
        if (data.description) {
          var desc = document.getElementById("desc-{{ owner }}-{{ name }}");
          if (desc && !desc.textContent.trim()) {
            desc.textContent = data.description;
          }
        }
        {% endunless %}
      })
      .catch(function () {});
  })();
</script>
